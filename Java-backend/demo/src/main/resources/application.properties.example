spring.application.name=demo

# Copy this file to application.properties and set local database credentials.
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false

spring.mvc.format.date=yyyy-MM-dd
spring.mvc.format.date-time=yyyy-MM-dd'T'HH:mm:ss
spring.mvc.format.time=HH:mm:ss

# Use a cryptographically random secret of at least 64 bytes for HS512.
jwt.secret=${JWT_SECRET}
admin.key=${ADMIN_KEY}
jwt.expiration-time=${JWT_EXPIRATION_TIME:86400000}

# Gmail SMTP defaults. Set SMTP_USERNAME and SMTP_PASSWORD to a Google App Password.
spring.mail.host=${SMTP_HOST:smtp.gmail.com}
spring.mail.port=${SMTP_PORT:587}
spring.mail.username=${SMTP_USERNAME:}
spring.mail.password=${SMTP_PASSWORD:}
spring.mail.properties.mail.smtp.auth=${SMTP_AUTH:true}
spring.mail.properties.mail.smtp.starttls.enable=${SMTP_STARTTLS:true}
spring.mail.properties.mail.smtp.ssl.enable=${SMTP_SSL:false}
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000
app.mail.from=${MAIL_FROM:${SMTP_USERNAME:noreply@localhost}}
app.frontend-base-url=${FRONTEND_BASE_URL:http://localhost:5173}
